{
  "expo": {
    "name": "HomeScreen",
    "slug": "HomeScreen",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B1527"
      },
      "permissions": ["android.permission.READ_TV_LISTINGS"],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "package": "com.anonymous.mytvapp"
    },
    "plugins": [
      "./plugins/withTvAppQueries",
      "./plugins/withNativeCleanOrder",
      "./plugins/withHomeScreenSplash",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/icon.png"
        }
      ],
      "expo-font"
    ]
  }
}
