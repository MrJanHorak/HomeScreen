{
  "expo": {
    "name": "HomeScreen",
    "slug": "HomeScreen",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ],
      "package": "com.anonymous.mytvapp"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true
        }
      ],
      "expo-font"
    ]
  }
}
