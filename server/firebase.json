{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "pairing-web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "X-Frame-Options", "value": "DENY"},
          {"key": "Referrer-Policy", "value": "no-referrer"},
          {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
          {"key": "Strict-Transport-Security", "value": "max-age=31536000"},
          {"key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app; frame-src https://*.firebaseapp.com https://*.web.app https://accounts.google.com; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"}
        ]
      }
    ],
    "redirects": [
      { "source": "/", "destination": "/dashboard", "type": 302 }
    ],
    "rewrites": [
      { "source": "/api/pollParticipant/**", "function": {"functionId": "pollParticipant", "region": "us-central1"} },
      { "source": "/vote/**", "destination": "/index.html" },
      { "source": "/polls", "destination": "/index.html" },
      { "source": "/people", "destination": "/index.html" },
      { "source": "/pair", "destination": "/index.html" },
      { "source": "/dashboard", "destination": "/index.html" },
      { "source": "/settings", "destination": "/index.html" },
      { "source": "/account", "destination": "/index.html" },
      { "source": "/meals", "destination": "/index.html" }
    ],
    "predeploy": ["npm --prefix pairing-web run build"]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
