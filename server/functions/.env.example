# Public Google OAuth client settings
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://us-central1-your-firebase-project.cloudfunctions.net/googleOAuthCallback

# Device Pairing URL for Smart TV
PAIRING_URL=https://your-firebase-project.web.app/pair

# Optional isolated Health test connection; leave disabled until configured.
GOOGLE_HEALTH_OAUTH_ENABLED=false
GOOGLE_HEALTH_CLIENT_ID=your-health-test-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_REDIRECT_URI=https://us-central1-your-firebase-project.cloudfunctions.net/googleHealthOAuthCallback

# Set GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, and OPENWEATHER_API_KEY
# with `firebase functions:secrets:set` for deployment.
# The optional googleHealthOAuthCallback also requires GOOGLE_HEALTH_CLIENT_SECRET.
