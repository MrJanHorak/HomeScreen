# Public Google OAuth client settings
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://us-central1-your-firebase-project.cloudfunctions.net/googleOAuthCallback

# Device Pairing URL for Smart TV
PAIRING_URL=https://your-firebase-project.web.app/pair

# Set GOOGLE_CLIENT_SECRET, TOKEN_ENCRYPTION_KEY, and OPENWEATHER_API_KEY
# with `firebase functions:secrets:set` for deployment.
